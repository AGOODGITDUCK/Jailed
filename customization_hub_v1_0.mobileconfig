<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- Web Clip Payload -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.jailed.webclip</string>
            <key>PayloadUUID</key>
            <string>c4f5b2e3-8d1a-4a9f-b6a8-9e3a1f3d2b7c</string>
            <key>PayloadDisplayName</key>
            <string>Jailed Access</string>
            <key>Label</key>
            <string>Jailed Access</string>
            <key>URL</key>
            <string>https://jailedaccess.onrender.com</string>
            <key>FullScreen</key>
            <true/>
            <key>IsRemovable</key>
            <true/>
            <key>Icon</key>
            <data>

            </data>
        </dict>

        <!-- Demo VPN Payload -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.jailed.demo.vpn</string>
            <key>PayloadUUID</key>
            <string>df482186-52e8-42fb-95a9-c0ba20531319</string>
            <key>PayloadDisplayName</key>
            <string>Jailed VPN Demo</string>
            <key>UserDefinedName</key>
            <string>Demo VPN</string>
            <key>VPNType</key>
            <string>IPSec</string>
            <key>RemoteAddress</key>
            <string>8.8.8.8</string>
            <key>AuthenticationMethod</key>
            <string>None</string>
        </dict>
    </array>

    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadIdentifier</key>
    <string>com.jailed.access.profile</string>
    <key>PayloadUUID</key>
    <string>e1d2f3a4-5678-90ab-cdef-1234567890ab</string>
    <key>PayloadDisplayName</key>
    <string>Jailed Access Profile</string>
</dict>
</plist>
