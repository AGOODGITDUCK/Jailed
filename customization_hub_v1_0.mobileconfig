<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- Web Clip payload -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.jailed.webclip</string>
            <key>PayloadUUID</key>
            <string>c4f5b2e3-8d1a-4a9f-b6a8-9e3a1f3d2b7c</string>
            <key>PayloadDisplayName</key>
            <string>Jailed Access</string>
            <key>Label</key>
            <string>Jailed Access</string>
            <key>URL</key>
            <string>https://jailedaccess.onrender.com</string>
            <key>FullScreen</key>
            <true/>
            <key>IsRemovable</key>
            <true/>
            <key>Icon</key>
            <data>

            </data>
        </dict>

        <!-- VPN payload example -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.jailed.vpnprofile</string>
            <key>PayloadUUID</key>
            <string>f2e1a3c4-7b9d-4e5f-a6b7-c8d9e0f1a2b3</string>
            <key>PayloadDisplayName</key>
            <string>Jailed VPN</string>
            <key>UserDefinedName</key>
            <string>Tokyo VPN</string>
            <key>VPNType</key>
            <string>IPSec</string>
            <key>RemoteAddress</key>
            <string>219.100.37.30</string>
            <key>AuthenticationMethod</key>
            <string>None</string>
        </dict>

    </array>

    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadIdentifier</key>
    <string>com.jailed.access.profile</string>
    <key>PayloadUUID</key>
    <string>9b8a7c6d-5e4f-4321-9876-abcdef123456</string>
    <key>PayloadDisplayName</key>
    <string>Jailed Access Profile</string>
</dict>
</plist>
