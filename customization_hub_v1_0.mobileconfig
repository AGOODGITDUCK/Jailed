<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Profile metadata -->
    <key>PayloadDisplayName</key>
    <string>Customization Hub Profile</string>

    <key>PayloadIdentifier</key>
    <string>com.example.profile.customizationhub.v1</string>

    <key>PayloadDescription</key>
    <string>Installs a Home Screen Web Clip for the Customization Hub (Profile version 1.0).</string>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <string>aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <!-- Custom version string requested -->
    <key>Version</key>
    <string>1.0</string>

    <!-- The actual payloads -->
    <key>PayloadContent</key>
    <array>
      <!-- Web Clip Payload -->
      <dict>
        <key>PayloadType</key>
        <string>com.apple.webClip.managed</string>

        <key>PayloadVersion</key>
        <integer>1</integer>

        <key>PayloadIdentifier</key>
        <string>com.example.webclip.customizationhub.v1</string>

        <key>PayloadUUID</key>
        <string>bbbbbbbb-bbbb-4bbb-bbbb-bbbbbbbbbbbb</string>

        <key>PayloadDisplayName</key>
        <string>Customization Hub Web Clip</string>

        <key>Label</key>
        <string>Customization Hub</string>

        <key>PayloadDescription</key>
        <string>Adds a web clip to the Home Screen that launches the Customization Hub web app.</string>

        <key>URL</key>
        <string>https://example.com/customization-hub/</string>

        <key>IsRemovable</key>
        <true/>

        <key>Precomposed</key>
        <true/>

        <key>FullScreen</key>
        <false/>

        <!-- Optional icon data: include base64 PNG here if you want a custom icon.
             Leaving it empty will let iOS fetch a site icon or show a generic icon. --
      </dict>
    </array>
  </dict>
</plist>

